---
import { nodes, edges } from '../data/pipeline';
import { type Lang, useTranslations, projectUrl } from '../i18n/ui';
import PipelineSvg from './PipelineSvg.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const scenarios = ['orchestration', 'quality', 'silver', 'iac'] as const;

/* Datos para el cliente: solo el idioma actual. */
const clientData = {
  nodes: nodes.map((n) => ({
    id: n.id,
    layer: n.layer,
    label: n.label[lang],
    tool: n.tool[lang],
    tools: n.tools,
    desc: n.desc[lang],
    ifRemoved: n.ifRemoved[lang],
    failure: n.failure,
    controls: n.controls ?? [],
    evidence: n.evidence.map((e) => ({ url: projectUrl(lang, e.project), title: e.title[lang], note: e.note[lang] })),
  })),
  edges,
  ui: {
    remove: t('pipeline.remove'),
    restore: t('pipeline.restore'),
    restoreAll: t('pipeline.restoreAll'),
    tools: t('pipeline.tools'),
    evidence: t('pipeline.evidence'),
    whatBreaks: t('pipeline.whatBreaks'),
    affected: t('pipeline.affected'),
    removedCount: t('pipeline.removedCount'),
    healthy: t('pipeline.healthy'),
    hint: t('pipeline.hint'),
    tour: t('pipeline.tour'),
    tourStop: t('pipeline.tourStop'),
    status: {
      stale: t('pipeline.status.stale'),
      dirty: t('pipeline.status.dirty'),
      risk: t('pipeline.status.risk'),
      removed: t('pipeline.status.removed'),
      partial: t('pipeline.status.partial'),
    },
  },
};
---

<div class="pipeline" data-pipeline>
  <div class="scenarios" role="group" aria-label={t('pipeline.scenarios')}>
    <span class="label">{t('pipeline.scenarios')}</span>
    {scenarios.map((s) => (
      <button type="button" class="chip-btn" data-scenario={s}>
        {t(`pipeline.scenario.${s}` as const)}
      </button>
    ))}
    <button type="button" class="chip-btn tour" data-tour>
      <span class="play" aria-hidden="true">▶</span>
      <span data-tour-label>{t('pipeline.tour')}</span>
    </button>
  </div>

  <div class="diagram-wrap">
    <PipelineSvg lang={lang} interactive={true} idPrefix="full" label={t('pipeline.svgLabel')} />
  </div>

  <aside class="panel card" data-panel aria-live="polite">
    <p class="panel-hint">{t('pipeline.hint')}</p>
    <p class="panel-healthy">{t('pipeline.healthy')}</p>
    <noscript><p class="panel-hint">{t('pipeline.noscript')}</p></noscript>
  </aside>

  <ul class="legend" aria-label="Leyenda">
    <li><span class="sw sw-removed"></span>{t('pipeline.legend.removed')}</li>
    <li><span class="sw sw-stale"></span>{t('pipeline.legend.stale')}</li>
    <li><span class="sw sw-partial"></span>{t('pipeline.legend.partial')}</li>
    <li><span class="sw sw-dirty"></span>{t('pipeline.legend.dirty')}</li>
    <li><span class="sw sw-risk"></span>{t('pipeline.legend.risk')}</li>
  </ul>

  <script type="application/json" data-pipeline-data set:html={JSON.stringify(clientData)} />
</div>

<script>
  type Status = 'ok' | 'risk' | 'partial' | 'stale' | 'dirty';
  type Failure = 'stops' | 'corrupts' | 'partial' | 'latent';
  interface N {
    id: string;
    layer: string;
    label: string;
    tool: string;
    tools: string[];
    desc: string;
    ifRemoved: string;
    failure: Failure;
    controls: string[];
    evidence: { url: string; title: string; note: string }[];
  }
  interface Data {
    nodes: N[];
    edges: { from: string; to: string }[];
    ui: Record<string, any>;
  }

  const RANK: Record<Status, number> = { ok: 0, risk: 1, partial: 2, stale: 3, dirty: 4 };
  const EMIT: Record<Failure, Status> = { stops: 'stale', corrupts: 'dirty', partial: 'partial', latent: 'ok' };
  const TOUR_ORDER = [
    'src_db', 'src_api', 'src_events', 'src_files',
    'ing_batch', 'ing_stream', 'lake',
    'silver', 'quality', 'gold',
    'dashboard', 'ml', 'api',
    'orchestration', 'governance', 'iac', 'monitoring',
  ];

  let tourTimer: number | null = null;
  function stopTourTimer() {
    if (tourTimer !== null) {
      window.clearInterval(tourTimer);
      tourTimer = null;
    }
  }

  function init(root: HTMLElement) {
    const data: Data = JSON.parse(root.querySelector('[data-pipeline-data]')!.textContent || '{}');
    const byId = new Map(data.nodes.map((n) => [n.id, n]));
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const nodeEls = new Map<string, SVGGElement>();
    root.querySelectorAll<SVGGElement>('.node').forEach((g) => nodeEls.set(g.dataset.id!, g));
    const edgeEls = Array.from(root.querySelectorAll<SVGPathElement>('.edge'));
    const flowEls = Array.from(root.querySelectorAll<SVGCircleElement>('.flow'));
    const tourBtn = root.querySelector<HTMLButtonElement>('[data-tour]');
    const tourLabel = root.querySelector<HTMLElement>('[data-tour-label]');

    const removed = new Set<string>();
    let selected: string | null = null;
    let touring = false;

    /* ---------- modelo ---------- */
    function compute(): Map<string, Status> {
      const status = new Map<string, Status>(data.nodes.map((n) => [n.id, 'ok']));
      const bump = (id: string, s: Status) => {
        if (removed.has(id)) return;
        if (RANK[s] > RANK[status.get(id)!]) status.set(id, s);
      };
      for (const id of removed) {
        const n = byId.get(id)!;
        const s: Status = n.failure === 'latent' ? 'risk' : EMIT[n.failure];
        for (const c of n.controls) bump(c, s);
      }
      const emitted = (id: string): Status => (removed.has(id) ? EMIT[byId.get(id)!.failure] : status.get(id)!);
      let changed = true;
      let guard = 0;
      while (changed && guard++ < 64) {
        changed = false;
        for (const n of data.nodes) {
          if (removed.has(n.id)) continue;
          const ins = data.edges.filter((e) => e.to === n.id).map((e) => emitted(e.from));
          if (!ins.length) continue;
          let derived: Status = 'ok';
          if (ins.includes('dirty')) derived = 'dirty';
          else if (ins.every((s) => s === 'stale')) derived = 'stale';
          else if (ins.some((s) => s === 'stale' || s === 'partial')) derived = 'partial';
          const cur = status.get(n.id)!;
          if (RANK[derived] > RANK[cur]) {
            status.set(n.id, derived);
            changed = true;
          }
        }
      }
      return status;
    }

    /* ---------- vista ---------- */
    function h(tag: string, attrs: Record<string, string> = {}, ...children: (string | Node)[]) {
      const el = document.createElement(tag);
      for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
      for (const c of children) el.append(c);
      return el;
    }

    function render() {
      const status = compute();
      for (const [id, g] of nodeEls) {
        const s = removed.has(id) ? 'removed' : status.get(id)!;
        g.classList.remove('is-removed', 'is-risk', 'is-partial', 'is-stale', 'is-dirty', 'is-selected', 'is-linked');
        if (s !== 'ok') g.classList.add(`is-${s}`);
        if (id === selected) g.classList.add('is-selected');
        g.setAttribute('aria-pressed', String(id === selected));
        const badge = g.querySelector<HTMLElement>('.nd-badge')!;
        if (s === 'ok') badge.hidden = true;
        else {
          badge.hidden = false;
          badge.textContent = data.ui.status[s];
        }
      }
      if (selected) for (const c of byId.get(selected)!.controls) nodeEls.get(c)?.classList.add('is-linked');

      const edgeStatus = (from: string): Status => (removed.has(from) ? EMIT[byId.get(from)!.failure] : status.get(from)!);
      for (const e of edgeEls) {
        const s = edgeStatus(e.dataset.from!);
        e.classList.remove('edge-partial', 'edge-stale', 'edge-dirty');
        if (s === 'partial' || s === 'stale' || s === 'dirty') e.classList.add(`edge-${s}`);
      }
      for (const f of flowEls) {
        const s = edgeStatus(f.dataset.from!);
        const toRemoved = removed.has(f.dataset.to!);
        f.classList.remove('off', 'dirty', 'partial');
        if (s === 'stale' || toRemoved) f.classList.add('off');
        else if (s === 'dirty') f.classList.add('dirty');
        else if (s === 'partial') f.classList.add('partial');
      }
      renderPanel(status);
    }

    function renderPanel(status: Map<string, Status>) {
      panel.replaceChildren();
      const ui = data.ui;

      if (removed.size) {
        const bar = h('div', { class: 'panel-bar' });
        bar.append(h('span', {}, `${removed.size} ${ui.removedCount}`));
        const btn = h('button', { type: 'button', class: 'btn btn-secondary btn-sm' }, ui.restoreAll);
        btn.addEventListener('click', () => {
          removed.clear();
          render();
        });
        bar.append(btn);
        panel.append(bar);
      }

      if (!selected) {
        panel.append(h('p', { class: 'panel-hint' }, ui.hint));
        panel.append(h('p', { class: 'panel-healthy' }, removed.size ? '' : ui.healthy));
        if (removed.size) appendAffected(status);
        return;
      }

      const n = byId.get(selected)!;
      const isRemoved = removed.has(n.id);
      const s = isRemoved ? 'removed' : status.get(n.id)!;

      const head = h('div', { class: 'panel-head' });
      const titleWrap = h('div', {});
      titleWrap.append(h('h3', { class: 'panel-title' }, n.label));
      titleWrap.append(h('p', { class: 'panel-tool' }, n.tool));
      head.append(titleWrap);
      if (s !== 'ok') head.append(h('span', { class: `status status-${s}` }, ui.status[s]));
      panel.append(head);

      panel.append(h('p', { class: 'panel-desc' }, n.desc));

      const chips = h('div', { class: 'chips' });
      for (const tool of n.tools) chips.append(h('span', { class: 'chip' }, tool));
      panel.append(h('p', { class: 'panel-label' }, ui.tools), chips);

      if (n.evidence.length) {
        panel.append(h('p', { class: 'panel-label' }, ui.evidence));
        const ul = h('ul', { class: 'evidence' });
        for (const e of n.evidence) {
          const li = h('li', {});
          li.append(h('a', { href: e.url }, e.title), h('span', {}, ` · ${e.note}`));
          ul.append(li);
        }
        panel.append(ul);
      }

      const action = h('button', { type: 'button', class: `btn btn-sm ${isRemoved ? 'btn-secondary' : 'btn-primary'}` }, isRemoved ? ui.restore : ui.remove);
      action.addEventListener('click', () => {
        stopTour();
        if (removed.has(n.id)) removed.delete(n.id);
        else removed.add(n.id);
        render();
      });
      panel.append(h('div', { class: 'panel-actions' }, action));

      if (isRemoved) {
        panel.append(h('p', { class: 'panel-label' }, ui.whatBreaks));
        panel.append(h('p', { class: 'panel-break' }, n.ifRemoved));
        appendAffected(status);
      }
    }

    function appendAffected(status: Map<string, Status>) {
      const affected = data.nodes
        .filter((n) => !removed.has(n.id) && status.get(n.id) !== 'ok')
        .sort((a, b) => RANK[status.get(b.id)!] - RANK[status.get(a.id)!]);
      if (!affected.length) return;
      panel.append(h('p', { class: 'panel-label' }, `${data.ui.affected} · ${affected.length}`));
      const ul = h('ul', { class: 'affected' });
      for (const n of affected) {
        const s = status.get(n.id)!;
        const li = h('li', {});
        li.append(h('span', { class: `status status-${s}` }, data.ui.status[s]), h('span', {}, n.label));
        li.addEventListener('click', () => {
          selected = n.id;
          render();
        });
        ul.append(li);
      }
      panel.append(ul);
    }

    /* ---------- recorrido guiado ---------- */
    function stopTour() {
      if (!touring) return;
      touring = false;
      stopTourTimer();
      root.classList.remove('touring');
      if (tourLabel) tourLabel.textContent = data.ui.tour;
    }
    function startTour() {
      stopTourTimer();
      touring = true;
      root.classList.add('touring');
      if (tourLabel) tourLabel.textContent = data.ui.tourStop;
      removed.clear();
      let i = 0;
      const step = () => {
        selected = TOUR_ORDER[i % TOUR_ORDER.length];
        i += 1;
        render();
      };
      step();
      tourTimer = window.setInterval(step, 3200);
    }

    /* ---------- eventos ---------- */
    for (const [id, g] of nodeEls) {
      const pick = () => {
        stopTour();
        selected = selected === id ? null : id;
        render();
      };
      g.addEventListener('click', pick);
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          pick();
        }
      });
    }

    root.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach((btn) => {
      btn.addEventListener('click', () => {
        stopTour();
        const id = btn.dataset.scenario!;
        removed.clear();
        removed.add(id);
        selected = id;
        render();
        if (window.innerWidth < 1180) panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    });

    tourBtn?.addEventListener('click', () => (touring ? stopTour() : startTour()));

    render();
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-pipeline]:not([data-ready])').forEach((el) => {
      el.dataset.ready = '1';
      init(el);
    });
  }
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', stopTourTimer);
  boot();
</script>

<style>
  .pipeline {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 1.25rem;
    align-items: start;
  }
  .scenarios {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .scenarios .label {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    margin-right: 0.25rem;
  }
  .chip-btn {
    font: inherit;
    font-size: 0.86rem;
    font-weight: 500;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s,
      transform 0.12s;
  }
  .chip-btn:hover {
    border-color: var(--accent);
    color: var(--accent-text);
    transform: translateY(-1px);
  }
  .tour {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border-color: var(--accent);
    color: var(--accent-text);
  }
  .play {
    font-size: 0.65rem;
  }
  .touring .tour {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .diagram-wrap {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem;
    box-shadow: var(--shadow);
  }
  .diagram-wrap :global(.diagram) {
    min-width: 760px;
  }

  /* panel */
  .panel {
    padding: 1.15rem 1.25rem 1.25rem;
    min-height: 200px;
    position: sticky;
    top: 80px;
    font-size: 0.93rem;
  }
  .panel :global(.panel-hint) {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
    margin-bottom: 0.5rem;
  }
  .panel :global(.panel-healthy) {
    color: var(--muted);
    margin: 0;
  }
  .panel :global(.panel-bar) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .panel :global(.panel-head) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .panel :global(.panel-title) {
    font-size: 1.1rem;
    margin: 0 0 0.15rem;
  }
  .panel :global(.panel-tool) {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0;
  }
  .panel :global(.panel-desc) {
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .panel :global(.panel-label) {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0.9rem 0 0.35rem;
  }
  .panel :global(.evidence) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .panel :global(.evidence a) {
    font-weight: 600;
  }
  .panel :global(.panel-actions) {
    margin-top: 1rem;
  }
  .panel :global(.panel-break) {
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    padding: 0.6rem 0.8rem;
    border-radius: 0 8px 8px 0;
    margin: 0;
  }
  .panel :global(.affected) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.3rem;
    font-size: 0.88rem;
  }
  .panel :global(.affected li) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }
  .panel :global(.affected li:hover) {
    color: var(--accent-text);
  }
  .panel :global(.status) {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .panel :global(.status-removed) {
    background: var(--faint);
    color: var(--bg);
  }
  .panel :global(.status-stale) {
    background: var(--border-strong);
    color: var(--text);
  }
  .panel :global(.status-partial) {
    background: var(--blue);
    color: #faf9f5;
  }
  .panel :global(.status-dirty) {
    background: var(--accent);
    color: #faf9f5;
  }
  .panel :global(.status-risk) {
    background: var(--ink);
    color: #faf9f5;
  }

  /* leyenda */
  .legend {
    grid-column: 1 / -1;
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .sw {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
  }
  .sw-removed {
    border-style: dashed;
    border-color: var(--faint);
  }
  .sw-stale {
    background: var(--bg-2);
    border-style: dotted;
  }
  .sw-partial {
    background: var(--blue-soft);
  }
  .sw-dirty {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .sw-risk {
    border-color: var(--ink);
    border-style: dotted;
  }

  @media (max-width: 1180px) {
    .pipeline {
      grid-template-columns: 1fr;
    }
    .panel {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .tour {
      margin-left: 0;
    }
  }
</style>
