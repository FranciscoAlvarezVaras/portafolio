---
import type { CollectionEntry } from 'astro:content';
import { type Lang, useTranslations, projectUrl } from '../i18n/ui';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
  index?: number;
}
const { lang, entry, index = 0 } = Astro.props;
const t = useTranslations(lang);
const d = entry.data;
const slug = entry.id.split('/').slice(1).join('/');
const url = projectUrl(lang, slug);
const catKey = `projects.category.${d.category}` as const;
---

<article class={`pcard card cat-${d.category}`} data-category={d.category} data-reveal style={`--i: ${index}`}>
  <a class="media" href={url} aria-hidden="true" tabindex="-1">
    {d.image ? <img src={d.image} alt="" loading="lazy" width="640" height="360" /> : <div class="placeholder"><span>{d.stack.slice(0, 3).join(' · ')}</span></div>}
  </a>
  <div class="body">
    <p class="meta">
      <span class="cat">{t(catKey)}</span>
      <span class="period">{d.period}</span>
    </p>
    <h3><a href={url}>{d.title}</a></h3>
    <p class="summary">{d.summary}</p>
    {d.result && <p class="result"><strong>{t('projects.result')}:</strong> {d.result}</p>}
    <p class="role"><strong>{t('projects.role')}:</strong> {d.role}</p>
    <div class="chips">
      {d.stack.slice(0, 5).map((s) => <span class="chip">{s}</span>)}
      {d.stack.length > 5 && <span class="chip chip-outline">+{d.stack.length - 5}</span>}
    </div>
    <a class="more" href={url}>{t('projects.viewCase')} →</a>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .pcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 2px 4px rgba(20, 20, 19, 0.05), 0 18px 36px -16px rgba(20, 20, 19, 0.22);
  }
  .media {
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .pcard:hover .media img {
    transform: scale(1.04);
  }
  .placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--muted);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%),
      repeating-linear-gradient(45deg, transparent 0 14px, color-mix(in srgb, var(--border) 60%, transparent) 14px 15px);
  }
  .cat-analytics .placeholder {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--green) 16%, transparent), transparent 60%),
      repeating-linear-gradient(45deg, transparent 0 14px, color-mix(in srgb, var(--border) 60%, transparent) 14px 15px);
  }
  .body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0;
  }
  .cat {
    color: var(--accent-text);
  }
  .cat-analytics .cat {
    color: var(--green);
  }
  .cat-engineering .cat {
    color: var(--blue);
  }
  h3 {
    font-size: 1.15rem;
    margin: 0;
  }
  h3 a {
    color: var(--text);
  }
  .summary {
    color: var(--muted);
    margin: 0;
  }
  .result,
  .role {
    margin: 0;
    font-size: 0.9rem;
  }
  .result strong,
  .role strong {
    color: var(--faint);
    font-weight: 600;
  }
  .chips {
    margin-top: 0.25rem;
  }
  .more {
    margin-top: auto;
    padding-top: 0.5rem;
    font-weight: 600;
    font-size: 0.92rem;
  }
</style>
