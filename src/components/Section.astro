---
interface Props {
  id: string;
  kicker: string;
  title: string;
  intro?: string;
  class?: string;
}
const { id, kicker, title, intro, class: cls } = Astro.props;
---

<section id={id} class={`section ${cls ?? ''}`}>
  <div class="container">
    <div class="section-head">
      <p class="kicker">{kicker}</p>
      <h2>{title}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>
    <slot />
  </div>
</section>
