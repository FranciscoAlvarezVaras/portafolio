---
import Base from '../layouts/Base.astro';
import Master from './Master.astro';
import Contact from './Contact.astro';
import { type Lang, useTranslations, routes, otherLang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
---

<Base lang={lang} path={r.master} altPath={routes[otherLang(lang)].master} title={`${t('meta.master')} · Francisco Álvarez Varas`} description={t('master.intro')}>
  <Master lang={lang} />
  <Contact lang={lang} />
</Base>
