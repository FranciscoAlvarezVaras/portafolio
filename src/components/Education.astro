---
import { type Lang, useTranslations, routes } from '../i18n/ui';
import { education, certifications } from '../data/profile';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id={routes[lang].anchors.education} kicker={t('education.kicker')} title={t('education.title')}>
  <ul class="list">
    {education.map((d) => (
      <li class="card">
        <span class="period">{d.period}</span>
        <div>
          <strong>{d.title[lang]}</strong>
          <span class="school">{d.school}</span>
          {d.note && <p>{d.note[lang]}</p>}
        </div>
      </li>
    ))}
  </ul>
  <p class="certs">
    <span class="label">{t('education.certs')}:</span>
    {certifications[lang].join(' · ')}
  </p>
</Section>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .list li {
    padding: 1rem 1.15rem;
    display: grid;
    gap: 0.35rem;
    box-shadow: none;
  }
  .period {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
  strong {
    display: block;
  }
  .school {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .list p {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .certs {
    color: var(--muted);
    margin: 0;
  }
  .label {
    font-family: var(--mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin-right: 0.35rem;
  }
</style>
